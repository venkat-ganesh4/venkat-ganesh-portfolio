
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminUser {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  sessions     Session[]
}

model Session {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  adminId   String
  expiresAt DateTime
  createdAt DateTime  @default(now())
  admin     AdminUser @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@index([adminId])
  @@index([expiresAt])
}

model SiteSettings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model Project {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  summary       String
  description   String   @default("")
  category      String?
  coverImage    String?
  galleryImages String[] @default([])
  githubUrl     String?
  liveUrl       String?
  techStack     String[]
  featured      Boolean  @default(false)
  published     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, sortOrder])
}

model SkillCategory {
  id        String   @id @default(cuid())
  name      String
  sortOrder Int      @default(0)
  skills    Skill[]
}

model Skill {
  id         String        @id @default(cuid())
  name       String
  categoryId String
  category   SkillCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  sortOrder  Int           @default(0)

  @@index([categoryId])
}


model Experience {
  id               String   @id @default(cuid())
  role              String
  company            String
  location           String?
  employmentType     String?
  startDate         DateTime
  endDate           DateTime?
  current           Boolean  @default(false)
  description        String   @default("")
  responsibilities   String[] @default([])
  technologies       String[] @default([])
  published          Boolean  @default(false)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([published, sortOrder])
}


model BlogPost {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  excerpt     String?
  content     String
  coverImage  String?
  published   Boolean  @default(false)
  publishedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Thought {
  id        String   @id @default(cuid())
  title     String
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MediaAsset {
  id        String   @id @default(cuid())
  url       String
  publicId  String   @unique
  filename  String?
  mimeType  String?
  createdAt DateTime @default(now())
}


model AnalyticsEvent {
  id           String   @id @default(cuid())
  visitorId    String
  sessionId    String?
  eventType    String
  pagePath     String
  target       String?
  source       String?
  deviceType   String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([eventType, createdAt])
  @@index([pagePath, createdAt])
  @@index([visitorId, createdAt])
  @@index([target, createdAt])
}
model Hobby {
  id            String   @id @default(cuid())
  title         String
  slug          String   @unique
  summary       String
  description   String   @default("")
  category      String?
  coverImage    String?
  galleryImages String[] @default([])
  published     Boolean  @default(false)
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([published, sortOrder])
}

model AboutContent {
  id            String   @id @default(cuid())
  key            String   @unique @default("main")
  pageTitle      String   @default("About Me")
  headline       String   @default("")
  intro          String   @default("")
  whoIAm         String   @default("")
  whatIExplore   String   @default("")
  beyondTech     String   @default("")
  myDirection    String   @default("")
  profileImage   String?
  published      Boolean  @default(false)
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model VisitorThought {
  id        String   @id @default(cuid())
  name      String
  email     String?
  content   String
  published Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([published, createdAt])
}


model ResumeContent {
  id                String   @id @default(cuid())
  key               String   @unique @default("main")

  pageTitle         String   @default("My Resume")
  headline          String   @default("Get to know my journey")
  intro             String   @default("Explore my professional background and experience.")

  // PDF resume
  pdfUrl            String?
  pdfPublicId       String?
  pdfFilename       String?

  // Video resume
  videoUrl          String?
  videoPublicId     String?
  videoFilename     String?
  videoThumbnail    String?

  // Public page visibility
  published         Boolean  @default(false)

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("unread")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([createdAt])
}